# Server Configuration
NODE_ENV=development
BACKEND_PORT=3001
# Bind address for local dev (default 127.0.0.1). Only widen deliberately.
BACKEND_HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# API Keys (if needed)
# Add any API keys here

# MCP server (/mcp). Generate the token with: openssl rand -hex 32
# MCP_OWNER_USER_ID is the Supabase auth user id every MCP call acts as.
MCP_TOKEN=
MCP_OWNER_USER_ID=
